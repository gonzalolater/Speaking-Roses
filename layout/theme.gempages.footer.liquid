<!--
Theme Name: VASTA Super Theme / Speaking Roses
Theme Version: 2.4 (Shopify OS 2.0 GemPages compatibility pass)
Description: GemPages footer-only layout preserving the legacy Speaking Roses behavior.
-->
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'lazyload-head' -%}
    <script>
      var bcpo_product={{ product | json }};
      {% if product.metafields.bcpo.bcpo_data %}var bcpo_data={{ product.metafields.bcpo.bcpo_data }};{% endif %}
      {% if shop.metafields.bcpo.bcpo_settings %}var bcpo_settings={{ shop.metafields.bcpo.bcpo_settings }};{% endif %}
      var inventory_quantity = [];
      {% for v in product.variants %}inventory_quantity.push({{ v.inventory_quantity }});{% endfor %}
      if (bcpo_product) {
        for (var i = 0; i < bcpo_product.variants.length; i += 1) {
          bcpo_product.variants[i].inventory_quantity = inventory_quantity[i];
        }
      }
      window.bcpo = window.bcpo || {};
      bcpo.cart = {{ cart | json }};
      bcpo.ogFormData = FormData;
    </script>

    {%- capture style_css -%}
      {%- render 'style-css' -%}
    {%- endcapture -%}
    {{- style_css | strip_newlines | replace: '    ', ' ' | replace: '   ', ' ' | replace: '  ', ' ' -}}

    <meta name="theme-name" content="Speaking Roses">
    <meta name="theme-version" content="2.4-os2-compat">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="UTF-8">

    {%- if template contains 'noindex' -%}
      <meta name="robots" content="noindex">
    {%- endif -%}

    {%- if settings.enable_zoom_feature_for_mobile -%}
      <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.75, user-scalable=yes">
    {%- else -%}
      <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    {%- endif -%}

    {%- assign meta_description = page_description | default: shop.description | default: shop.name -%}
    <meta name="description" content="{{ meta_description | strip_html | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.enable_custom_style -%}
      {%- render 'custom_head' -%}
    {%- endif -%}

    {%- if settings.enable_zoom_feature_for_desktop and template contains 'product' -%}
      {% # Magnify is a required third-party dependency for the legacy product zoom feature. %}
      {% # theme-check-disable-next-line RemoteAsset %}
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/magnify/2.3.3/css/magnify.css">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">
    {%- else -%}
      <link rel="shortcut icon" href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" type="image/png">
    {%- endif -%}

    {%- capture seo_title -%}
      {%- if template contains 'search' -%}
        Search: {{ search.results_count }} results found for "{{ search.terms }}"
      {%- else -%}
        {{ page_title }}
      {%- endif -%}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' -%} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}
      {%- endif -%}
      {%- if current_page != 1 -%}
        | {{ 'general.meta.page' | t: page: current_page }}
      {%- endif -%}
    {%- endcapture -%}

    <title>{{ seo_title | strip }} | {{ shop.name }}</title>

    <!-- Required for Shopify app embeds and platform-injected storefront scripts. -->
    {{ content_for_header }}

    {{ settings.enable_html_head }}

    {%- if settings.custom_css != blank -%}
      <style>{{ settings.custom_css }}</style>
    {%- endif -%}

    {%- if settings.app_review == 'yotpo' -%}
      <script type="lazyload_int">
        (function e() {
          var e = document.createElement('script');
          (e.type = 'text/javascript'),
            (e.async = true),
            (e.src = 'https://staticw2.yotpo.com/{{ settings.yotpo_key }}/widget.js');
          var t = document.getElementsByTagName('script')[0];
          t.parentNode.insertBefore(e, t);
        })();
      </script>
    {%- endif -%}

    {%- if settings.app_review == 'judgeme' -%}
      {% render 'judgeme_core' %}
    {%- endif -%}

    {% render 'tracking-script' %}

    {%- if settings.app_review == 'loox' -%}
      {{ shop.metafields.loox.global_html_head }}
    {%- endif -%}

    {% # Custom Price Calculator vendor scripts are intentionally remote. %}
    {% # theme-check-disable-next-line RemoteAsset %}
    <script defer src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    {% # theme-check-disable-next-line RemoteAsset %}
    <script defer src="https://cdn-assets.custompricecalculator.com/shopify/calculator.js"></script>
  </head>

  {%- assign template_suffix = template.suffix | handle -%}
  {%- assign template_suffix = ' ' | append: template_suffix -%}
  {%- if template_suffix == ' ' -%}
    {%- assign template_suffix = '' -%}
  {%- endif -%}

  <body id="{{ page_title | handle }}" class="template-{{ template.name | handle }}{{ template_suffix }}">
    <h1 class="hide">{{ page_title }}</h1>

    <!-- Preserve the legacy footer-only behavior while keeping section instances available. -->
    <header class="header-content" hidden>
      {%- if settings.enable_shipping_bar -%}
        {%- if settings.enable_shipping_bar_only_homepage == false or template.name contains 'index' -%}
          {%- section 'shipping_bar' -%}
        {%- endif -%}
      {%- endif -%}
      {%- section 'custom-header' -%}
    </header>

    <main id="MainContent" class="main-content">
      <aside>
        {%- unless settings.only_shipping_bar == false and template contains 'cart' -%}
          {%- section 'menu-mobile' -%}
        {%- endunless -%}
      </aside>

      <div class="DrawerOverlay"></div>

      <section id="{{ template.name }}-layout">
        <h2 class="hide">{{ template.name | capitalize }} Content</h2>
        {{ content_for_layout }}
        <limespot></limespot>

        {%- assign enable_recently_viewed_product = true -%}
        {%- if settings.disable_recently_viewed_on_product_page and template contains 'product' -%}
          {%- assign enable_recently_viewed_product = false -%}
        {%- elsif settings.disable_recently_viewed_on_homepage_page and template contains 'index' -%}
          {%- assign enable_recently_viewed_product = false -%}
        {%- elsif settings.disable_recently_viewed_on_collection_page and template contains 'collection' -%}
          {%- assign enable_recently_viewed_product = false -%}
        {%- endif -%}
      </section>

      <aside>
        {%- unless settings.disable_cartDrawer -%}
          {%- unless template.name == 'cart' -%}
            {%- section 'cart-drawer' -%}
          {%- endunless -%}
        {%- endunless -%}
      </aside>

      {%- if enable_recently_viewed_product -%}
        {%- render 'recently-viewed-products' -%}
      {%- endif -%}
    </main>

    <footer class="footer-content">
      {%- section 'footer' -%}
      {%- if settings.enable_button_to_the_top -%}
        {%- render 'scrollbutton' -%}
      {%- endif -%}
    </footer>

    {%- capture vasta_scripts -%}
      {%- render 'vasta-scripts' -%}
    {%- endcapture -%}
    {{- vasta_scripts | strip_newlines | replace: '    ', ' ' | replace: '   ', ' ' | replace: '  ', ' ' -}}

    {{ settings.enable_html_body }}

    {%- if settings.product_enabled_recharge -%}
      {%- render 'subscription-theme-footer' -%}
    {%- endif -%}

    {%- if settings.app_review == 'loox' -%}
      {{ shop.metafields.loox['global_html_body'] }}
    {%- endif -%}

    {%- render 'lazyload-body' -%}
  </body>
</html>
