{% assign journal = section.settings.blog %}
<section class="sr-journal">
  <div class="sr-shell">
    <div class="sr-journal__head">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="sr-kicker">{{ section.settings.eyebrow }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      </div>
      {% if journal != blank %}<a href="{{ journal.url }}">View all</a>{% endif %}
    </div>
    <div class="sr-journal__grid">
      {% if journal != blank %}
        {% for article in journal.articles limit: 3 %}
          <article class="sr-journal__card">
            <a href="{{ article.url }}" class="sr-journal__media">
              {% if article.image != blank %}
                {{ article.image | image_url: width: 1100 | image_tag:
                  class: 'sr-journal__image',
                  loading: 'lazy',
                  widths: '400, 650, 850, 1100',
                  sizes: '(min-width: 900px) 33vw, 100vw'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'sr-journal__image' }}
              {% endif %}
            </a>
            <div class="sr-journal__copy">
              <p>{{ article.published_at | date: "%B %d, %Y" }}</p>
              <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
              {% if section.settings.show_excerpt and article.excerpt_or_content != blank %}
                <div>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .sr-journal { padding:88px 0; background:{{ section.settings.background }}; color:{{ section.settings.text_color }}; }
  #shopify-section-{{ section.id }} .sr-shell { width:min(1420px,calc(100% - 40px)); margin:0 auto; }
  #shopify-section-{{ section.id }} .sr-journal__head { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:34px; gap:28px; }
  #shopify-section-{{ section.id }} .sr-kicker { margin:0 0 9px; text-transform:uppercase; letter-spacing:.18em; font-size:11px; font-weight:700; }
  #shopify-section-{{ section.id }} .sr-journal__head h2 { margin:0; font:400 clamp(34px,4vw,54px)/1.05 Georgia,'Times New Roman',serif; }
  #shopify-section-{{ section.id }} .sr-journal__head > a { color:inherit; text-decoration:none; text-transform:uppercase; letter-spacing:.1em; font-size:11px; border-bottom:1px solid currentColor; padding-bottom:4px; }
  #shopify-section-{{ section.id }} .sr-journal__grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  #shopify-section-{{ section.id }} .sr-journal__media { display:block; aspect-ratio:1.35/1; overflow:hidden; background:#eee8e5; }
  #shopify-section-{{ section.id }} .sr-journal__image { display:block; width:100%; height:100%; object-fit:cover; }
  #shopify-section-{{ section.id }} .sr-journal__copy { padding-top:18px; }
  #shopify-section-{{ section.id }} .sr-journal__copy > p { margin:0 0 8px; text-transform:uppercase; letter-spacing:.12em; font-size:10px; opacity:.62; }
  #shopify-section-{{ section.id }} .sr-journal__copy h3 { margin:0; font:400 clamp(22px,2.2vw,32px)/1.12 Georgia,'Times New Roman',serif; }
  #shopify-section-{{ section.id }} .sr-journal__copy h3 a { color:inherit; text-decoration:none; }
  #shopify-section-{{ section.id }} .sr-journal__copy div { margin-top:10px; line-height:1.55; opacity:.7; font-size:14px; }
  @media(max-width:899px){#shopify-section-{{ section.id }} .sr-journal__grid{grid-template-columns:1fr;gap:38px;}}
  @media(max-width:599px){#shopify-section-{{ section.id }} .sr-journal{padding:62px 0;}#shopify-section-{{ section.id }} .sr-shell{width:min(100% - 28px,1420px);}}
</style>

{% schema %}
{
  "name":"SR | Journal",
  "tag":"section",
  "settings":[
    {"type":"blog","id":"blog","label":"Blog"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"From the journal"},
    {"type":"text","id":"heading","label":"Heading","default":"Stories, makers and details"},
    {"type":"checkbox","id":"show_excerpt","label":"Show excerpts","default":true},
    {"type":"color","id":"background","label":"Background","default":"#f7f4f2"},
    {"type":"color","id":"text_color","label":"Text color","default":"#171515"}
  ],
  "presets":[{"name":"SR | Journal"}]
}
{% endschema %}