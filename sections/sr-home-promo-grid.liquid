<section class="sr-promos">
  <div class="sr-shell">
    {% if section.settings.eyebrow != blank %}<p class="sr-kicker">{{ section.settings.eyebrow }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="sr-heading">{{ section.settings.heading }}</h2>{% endif %}
    <div class="sr-promos__grid">
      {% for block in section.blocks %}
        {% liquid
          assign promo_collection = block.settings.collection
          assign promo_image = block.settings.image
          if promo_image == blank and promo_collection != blank
            assign promo_image = promo_collection.image
            if promo_image == blank and promo_collection.products.first != blank
              assign promo_image = promo_collection.products.first.featured_image
            endif
          endif
          assign promo_heading = block.settings.heading
          if promo_heading == blank and promo_collection != blank
            assign promo_heading = promo_collection.title
          endif
          assign promo_link = block.settings.link
          if promo_link == blank and promo_collection != blank
            assign promo_link = promo_collection.url
          endif
        %}
        <article class="sr-promo" {{ block.shopify_attributes }}>
          <a href="{{ promo_link | default: routes.all_products_collection_url }}" class="sr-promo__link">
            <div class="sr-promo__media">
              {% if promo_image != blank %}
                {{ promo_image | image_url: width: 1200 | image_tag:
                  class: 'sr-promo__image',
                  loading: 'lazy',
                  widths: '420, 640, 900, 1200',
                  sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw'
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'sr-promo__image sr-promo__placeholder' }}
              {% endif %}
            </div>
            <div class="sr-promo__shade"></div>
            <div class="sr-promo__content">
              {% if block.settings.eyebrow != blank %}<p>{{ block.settings.eyebrow }}</p>{% endif %}
              <h3>{{ promo_heading }}</h3>
              {% if block.settings.caption != blank %}<span>{{ block.settings.caption }}</span>{% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .sr-promos { padding: 78px 0; background: {{ section.settings.background }}; color: {{ section.settings.text_color }}; }
  #shopify-section-{{ section.id }} .sr-shell { width: min(1420px, calc(100% - 40px)); margin: 0 auto; }
  #shopify-section-{{ section.id }} .sr-kicker { margin: 0 0 10px; text-transform: uppercase; letter-spacing: .18em; font-size: 11px; font-weight: 700; text-align: center; }
  #shopify-section-{{ section.id }} .sr-heading { margin: 0 0 38px; font: 400 clamp(34px,4vw,54px)/1.05 Georgia,'Times New Roman',serif; text-align: center; letter-spacing: -.02em; }
  #shopify-section-{{ section.id }} .sr-promos__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  #shopify-section-{{ section.id }} .sr-promo { position: relative; min-height: 500px; overflow: hidden; }
  #shopify-section-{{ section.id }} .sr-promo__link { position: absolute; inset: 0; color: #fff; text-decoration: none; }
  #shopify-section-{{ section.id }} .sr-promo__media, #shopify-section-{{ section.id }} .sr-promo__shade { position: absolute; inset: 0; }
  #shopify-section-{{ section.id }} .sr-promo__image { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  #shopify-section-{{ section.id }} .sr-promo__shade { background: linear-gradient(0deg, rgba(0,0,0,.62), rgba(0,0,0,.04) 68%); }
  #shopify-section-{{ section.id }} .sr-promo__content { position: absolute; inset: auto 24px 26px; }
  #shopify-section-{{ section.id }} .sr-promo__content p { margin: 0 0 8px; text-transform: uppercase; letter-spacing: .14em; font-size: 10px; font-weight: 700; }
  #shopify-section-{{ section.id }} .sr-promo__content h3 { margin: 0; font: 400 clamp(28px,2.4vw,40px)/1 Georgia,'Times New Roman',serif; }
  #shopify-section-{{ section.id }} .sr-promo__content span { display: inline-block; margin-top: 10px; border-bottom: 1px solid rgba(255,255,255,.8); padding-bottom: 2px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .sr-promo:hover .sr-promo__image { transform: scale(1.035); }
  @media (max-width: 989px) { #shopify-section-{{ section.id }} .sr-promos__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 599px) {
    #shopify-section-{{ section.id }} .sr-promos { padding: 58px 0; }
    #shopify-section-{{ section.id }} .sr-shell { width: min(100% - 28px, 1420px); }
    #shopify-section-{{ section.id }} .sr-promos__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .sr-promo { min-height: 420px; }
  }
</style>

{% schema %}
{
  "name":"SR | Promo grid",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by collection"},
    {"type":"text","id":"heading","label":"Heading","default":"Find something worth keeping"},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text color","default":"#171515"}
  ],
  "blocks":[
    {
      "type":"promo",
      "name":"Promo",
      "settings":[
        {"type":"collection","id":"collection","label":"Collection"},
        {"type":"image_picker","id":"image","label":"Custom image"},
        {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured collection"},
        {"type":"text","id":"heading","label":"Heading"},
        {"type":"text","id":"caption","label":"Link label","default":"Explore"},
        {"type":"url","id":"link","label":"Custom link"}
      ]
    }
  ],
  "max_blocks":4,
  "presets":[{"name":"SR | Promo grid","blocks":[{"type":"promo"},{"type":"promo"},{"type":"promo"},{"type":"promo"}]}]
}
{% endschema %}