<section class="sr-editorial">
  <div class="sr-shell">
    <div class="sr-editorial__head">
      {% if section.settings.eyebrow != blank %}<p class="sr-kicker">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    </div>
    <div class="sr-editorial__grid">
      {% for block in section.blocks %}
        {% liquid
          assign card_collection = block.settings.collection
          assign card_image = block.settings.image
          if card_image == blank and card_collection != blank
            assign card_image = card_collection.image
            if card_image == blank and card_collection.products.first != blank
              assign card_image = card_collection.products.first.featured_image
            endif
          endif
          assign card_link = block.settings.link
          if card_link == blank and card_collection != blank
            assign card_link = card_collection.url
          endif
        %}
        <article class="sr-editorial__card" {{ block.shopify_attributes }}>
          <a href="{{ card_link | default: routes.all_products_collection_url }}">
            <div class="sr-editorial__media">
              {% if card_image != blank %}
                {{ card_image | image_url: width: 1400 | image_tag:
                  class: 'sr-editorial__image',
                  loading: 'lazy',
                  widths: '500, 800, 1100, 1400',
                  sizes: '(min-width: 750px) 50vw, 100vw'
                }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'sr-editorial__image' }}
              {% endif %}
            </div>
            <div class="sr-editorial__copy">
              {% if block.settings.eyebrow != blank %}<p>{{ block.settings.eyebrow }}</p>{% endif %}
              <h3>{{ block.settings.heading | default: card_collection.title }}</h3>
              {% if block.settings.text != blank %}<div>{{ block.settings.text }}</div>{% endif %}
              <span>{{ block.settings.link_label }}</span>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .sr-editorial { padding:88px 0; background:{{ section.settings.background }}; color:{{ section.settings.text_color }}; }
  #shopify-section-{{ section.id }} .sr-shell { width:min(1420px,calc(100% - 40px)); margin:0 auto; }
  #shopify-section-{{ section.id }} .sr-editorial__head { text-align:center; margin-bottom:36px; }
  #shopify-section-{{ section.id }} .sr-kicker { margin:0 0 10px; text-transform:uppercase; letter-spacing:.18em; font-size:11px; font-weight:700; }
  #shopify-section-{{ section.id }} .sr-editorial__head h2 { margin:0; font:400 clamp(34px,4vw,54px)/1.05 Georgia,'Times New Roman',serif; }
  #shopify-section-{{ section.id }} .sr-editorial__grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
  #shopify-section-{{ section.id }} .sr-editorial__card a { color:inherit; text-decoration:none; }
  #shopify-section-{{ section.id }} .sr-editorial__media { aspect-ratio:1.35/1; overflow:hidden; background:#eee8e5; }
  #shopify-section-{{ section.id }} .sr-editorial__image { width:100%; height:100%; object-fit:cover; display:block; transition:transform .5s ease; }
  #shopify-section-{{ section.id }} .sr-editorial__card:hover .sr-editorial__image { transform:scale(1.025); }
  #shopify-section-{{ section.id }} .sr-editorial__copy { padding:22px 4px 0; }
  #shopify-section-{{ section.id }} .sr-editorial__copy > p { margin:0 0 8px; text-transform:uppercase; letter-spacing:.14em; font-size:10px; font-weight:700; }
  #shopify-section-{{ section.id }} .sr-editorial__copy h3 { margin:0; font:400 clamp(28px,3vw,42px)/1.05 Georgia,'Times New Roman',serif; }
  #shopify-section-{{ section.id }} .sr-editorial__copy div { margin-top:10px; max-width:570px; opacity:.72; line-height:1.6; }
  #shopify-section-{{ section.id }} .sr-editorial__copy div p { margin:0; }
  #shopify-section-{{ section.id }} .sr-editorial__copy span { display:inline-block; margin-top:16px; text-transform:uppercase; letter-spacing:.1em; font-size:11px; border-bottom:1px solid currentColor; padding-bottom:4px; }
  @media(max-width:699px){
    #shopify-section-{{ section.id }} .sr-editorial{padding:62px 0;}
    #shopify-section-{{ section.id }} .sr-shell{width:min(100% - 28px,1420px);}
    #shopify-section-{{ section.id }} .sr-editorial__grid{grid-template-columns:1fr;gap:42px;}
  }
</style>

{% schema %}
{
  "name":"SR | Editorial cards",
  "tag":"section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Explore more"},
    {"type":"text","id":"heading","label":"Heading","default":"Collections with character"},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text color","default":"#171515"}
  ],
  "blocks":[
    {"type":"card","name":"Editorial card","settings":[
      {"type":"collection","id":"collection","label":"Collection"},
      {"type":"image_picker","id":"image","label":"Custom image"},
      {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Discover"},
      {"type":"text","id":"heading","label":"Heading"},
      {"type":"richtext","id":"text","label":"Text","default":"<p>Explore a focused edit from this collection.</p>"},
      {"type":"text","id":"link_label","label":"Link label","default":"View collection"},
      {"type":"url","id":"link","label":"Custom link"}
    ]}
  ],
  "max_blocks":2,
  "presets":[{"name":"SR | Editorial cards","blocks":[{"type":"card"},{"type":"card"}]}]
}
{% endschema %}